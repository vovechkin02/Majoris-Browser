using MajorisBrowser;
int main(string[] args){
    try{Gtk.init();MajorisCef.initialize(args[3],args[1],args[2]);if((MajorisCef.capabilities()&2)!=0)FileUtils.set_contents(Path.build_filename(args[3],"custom-expected"),"1");var surface=new OffscreenBrowserSurface(Path.build_filename(args[3],"browser"),false,args[4]);var window=new Gtk.Window();window.title="Majoris accessibility fixture";window.set_default_size(800,500);window.child=surface;var loop=new MainLoop();
        surface.engine.event.connect((kind,value)=>{if(kind=="accessibility-tree" && value.contains("majoris_document")){try{FileUtils.set_contents(Path.build_filename(args[3],"custom-ax"),"1");}catch(Error e){error("%s",e.message);}}});bool scheduled=false;surface.changed.connect((kind,value)=>{if(kind=="closed")loop.quit();if(kind=="loading" && value=="0" && !scheduled){scheduled=true;Timeout.add(100,()=>{if(!FileUtils.test(Path.build_filename(args[3],"continue"),FileTest.EXISTS))return Source.CONTINUE;surface.grab_focus();surface.engine.evaluate("document.body.style.marginLeft='80px';document.querySelector('#name').focus();document.querySelector('#name').value='Updated text';document.querySelector('#name').setSelectionRange(2,7);document.querySelector('#timed').textContent='Timer fixture status'");return Source.REMOVE;});}});window.close_request.connect(()=>{surface.close();return false;});window.present();bool finishing=false;uint finish_timer=Timeout.add(100,()=>{if(!finishing && FileUtils.test(Path.build_filename(args[3],"finish"),FileTest.EXISTS)){finishing=true;surface.close();}return Source.CONTINUE;});uint timer=Timeout.add_seconds(35,()=>{surface.close();loop.quit();return Source.REMOVE;});loop.run();Source.remove(timer);Source.remove(finish_timer);window.destroy();MajorisCef.shutdown();
    }catch(Error e){error("%s",e.message);}return 0;
}

using MajorisBrowser;
int main(string[] args){
    try{MajorisCef.initialize(args[3],args[1],args[2]);var view=new MajorisCef.View(Path.build_filename(args[3],"browser"),false,args[4]);var loop=new MainLoop();int step=0,metrics_round=0;bool cert=false,success=false;string origin=UrlResolver.origin(args[4]),killed_task="",untrusted="";bool denied_certificate=false,fullscreen_entered=false,fullscreen_exited=false;
        view.event.connect((kind,value)=>{
            try{
                if(kind=="fullscreen"){if(value=="1")fullscreen_entered=true;if(value=="0" && fullscreen_entered)fullscreen_exited=true;stdout.printf("HTML fullscreen transition: %s\n",value);}
                if(kind=="certificate"){var parser=new Json.Parser();parser.load_from_data(value);var data=parser.get_root().get_object();if(data.get_boolean_member("secure")){assert(data.get_int_member("status")==0 && data.get_string_member("hostname")=="localhost");assert(data.get_double_member("validUntil")>data.get_double_member("validFrom"));assert(data.get_string_member("pem").contains("BEGIN CERTIFICATE"));cert=true;}}
                if(kind=="loading" && value=="0" && step==0){step=1;view.evaluate("navigator.userAgentData.getHighEntropyValues(['fullVersionList','platformVersion','architecture','bitness']).then(async h=>{const headers=await(await fetch('/fixture-headers')).json();const compatibility=await verifyCompatibility();const untrusted=await(await fetch('/fixture-security')).text();return JSON.stringify({ua:navigator.userAgent,brands:h.fullVersionList,platform:navigator.userAgentData.platform,headers,compatibility,untrusted});})");}
                if(kind=="evaluation" && step==1){var parser=new Json.Parser();parser.load_from_data(value);string text=parser.get_root().get_object().get_object_member("result").get_string_member("value");assert(text.contains("Majoris/") && text.contains("Majoris") && text.contains("Chromium") && text.contains("Linux") && text.contains("sec-ch-ua"));parser.load_from_data(text);var report=parser.get_root().get_object();untrusted=report.get_string_member("untrusted");var compatibility=report.get_object_member("compatibility");foreach(string probe in new string[]{"wasm","websocket","rtc","fileDenied","sop","edit","nativeHidden"})assert(compatibility.get_boolean_member(probe));stdout.printf("Compatibility capabilities: %s\n",Json.to_string(report.get_member("compatibility"),false));var headers=report.get_object_member("headers");foreach(string phase in new string[]{"initial","current"}){var identity=headers.get_object_member(phase);assert(identity.get_string_member("user-agent").contains("Majoris/0.1.0"));assert(identity.get_string_member("sec-ch-ua").contains("\"Majoris\";v=\"0\"") && identity.get_string_member("sec-ch-ua").contains("\"Chromium\";v=\"152\""));}step=2;view.pointer(1,50,30,1,0,0,0);view.pointer(2,50,30,1,0,0,0);}
                if(kind=="audio" && value=="1" && step==2){step=3;view.command("mute");}
                if(kind=="muted" && value=="1" && step==3){step=4;view.evaluate("context.suspend().then(()=>true)");}
                if(kind=="audio" && value=="0" && step==4){step=5;view.command("mute");}
                if(kind=="muted" && value=="0" && step==5){step=6;view.evaluate("video.play().then(()=>new Promise(resolve=>setTimeout(()=>resolve(video.readyState>=2),300)))");}
                if(kind=="audio" && value=="1" && step>=5)error("Silent canvas video incorrectly reported audio");
                if(kind=="evaluation" && step==6){step=7;view.command("picture-in-picture");}
                if(kind=="operation-error" && value=="picture-in-picture" && step==7){assert(!MajorisCef.has_native_pip());assert(cert);step=12;view.command("tasks");}
                if(kind=="tasks" && step==12){if(metrics_round++==0){Timeout.add(1600,()=>{view.command("tasks");return Source.REMOVE;});return;}string current="";int count=0;foreach(string line in value.split("\n")){var fields=line.split("\t");if(fields.length!=9 && fields.length!=12)continue;if(fields.length==12){assert(int64.parse(fields[9])>0 && int64.parse(fields[10])>=0);}count++;assert(double.parse(fields[2])>=0 && int64.parse(fields[3])>=-1 && int64.parse(fields[6])>=-1);if(fields[8]=="1" && fields[4]=="1"){current=fields[0];if((MajorisCef.capabilities()&4)!=0){assert(fields.length==12);assert(FileUtils.test("/proc/"+fields[9]+"/status",FileTest.IS_REGULAR));stdout.printf("Chromium current renderer metrics: pid=%s network-bytes/sec=%s root-task=%s\n",fields[9],fields[10],fields[11]);}}}assert(count>0 && current!="");step=13;killed_task=current;view.command("kill-task:"+current);}
                if(kind=="crashed" && step==13){step=14;view.load(untrusted);}
                if(kind=="certificate" && step==14){var p=new Json.Parser();p.load_from_data(value);var c=p.get_root().get_object();if(c.get_int_member("status")!=0){assert(!c.get_boolean_member("secure"));denied_certificate=true;}}
                if(kind=="error" && step==14){assert(denied_certificate && value.contains("CERT"));success=true;view.close();}
                if(kind=="operation-complete" && value=="picture-in-picture" && step==7){step=8;view.evaluate("document.pictureInPictureElement===video");}
                if(kind=="evaluation" && step==8){var parser=new Json.Parser();parser.load_from_data(value);assert(parser.get_root().get_object().get_object_member("result").get_boolean_member("value"));step=9;view.command("picture-in-picture");}
                if(kind=="operation-complete" && value=="picture-in-picture" && step==9){step=10;view.evaluate("document.pictureInPictureElement===null");}
                if(kind=="evaluation" && step==10){var parser=new Json.Parser();parser.load_from_data(value);assert(parser.get_root().get_object().get_object_member("result").get_boolean_member("value"));assert(cert);step=12;view.command("tasks");}
                if(kind=="closed")loop.quit();
            }catch(Error e){error("%s",e.message);}
        });uint timer=Timeout.add_seconds(25,()=>{stderr.printf("Platform fixture timed out at step %d\n",step);view.close();loop.quit();return Source.REMOVE;});loop.run();Source.remove(timer);MajorisCef.shutdown();assert(success && fullscreen_entered && fullscreen_exited);stdout.printf("Verified certificate, HTTP/high-entropy identity, running/suspended WebAudio, host mute, silent video and runtime-gated native PiP lifecycle: PASS\n");
    }catch(Error e){error("%s",e.message);}return 0;
}

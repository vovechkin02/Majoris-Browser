project('majoris-browser', ['c', 'cpp', 'vala'], version: '0.1.0', meson_version: '>=1.0', default_options: ['cpp_std=c++20', 'warning_level=2'])
gnome = import('gnome')
i18n = import('i18n')
glib = dependency('glib-2.0', version: '>=2.76')
gio = dependency('gio-2.0')
sqlite = dependency('sqlite3')
gee = dependency('gee-0.8')
json = dependency('json-glib-1.0')
domain_sources = files('src/core/url-resolver.vala', 'src/profiles/profile-paths.vala', 'src/services/store.vala', 'src/webapps/navigation-policy.vala', 'src/webapps/authentication-policy.vala', 'src/webapps/manifest-discovery.vala', 'src/webapps/web-app.vala', 'src/tabs/tab-model.vala')
domain_deps = [glib, gio, sqlite, gee, json, dependency('libxml-2.0')]
domain_sources += files('src/webapps/web-app-installer.vala')
domain_sources += files('src/bookmarks/bookmark-format.vala')
domain_sources += files('src/bookmarks/profile-import.vala')
domain_sources += files('src/sessions/exit-operation.vala')
domain_sources += files('src/tabs/tab-audio-state.vala')
security_sources=files('src/security/threat-verdict.vala','src/security/threat-provider.vala','src/security/threat-cache.vala','src/security/threat-protection-service.vala')
domain_sources+=security_sources
drag_sources=files('tests/integration/drag.vala','src/ui/browser-surface.vala','src/ui/web-drag.vala','src/ui/web-drop.vala','src/ui/web-accessibility.vala','src/tabs/tab-audio-state.vala','src/core/url-resolver.vala')
accessibility_sources=files('tests/integration/accessibility.vala','src/ui/browser-surface.vala','src/ui/web-drag.vala','src/ui/web-drop.vala','src/ui/web-accessibility.vala','src/tabs/tab-audio-state.vala','src/core/url-resolver.vala')
subdir('tests')
if not get_option('domain_only')
  gtk = dependency('gtk4', version: '>=4.18')
  adw = dependency('libadwaita-1', version: '>=1.5')
  subdir('native/cef')
  isolation_test = executable('cef-isolation-test', 'tests/cef/isolation.vala', 'native/cef/vala/majoris-cef.vapi', dependencies: [gio, cef_dep])
  python = find_program('python3')
  playback_test=executable('cef-playback-test','tests/cef/playback.vala','native/cef/vala/majoris-cef.vapi',dependencies:[gio,json,cef_dep])
  test('cef-media-playback',python,args:[meson.project_source_root()/'tests/cef/permissions-runner.py',playback_test.full_path(),meson.project_build_root()/'native/cef/majoris-browser-cef-subprocess',cef_root/'Release',meson.project_source_root()/'tests/fixtures','playback.html'],env:['MAJORIS_CEF_TEST_HEADLESS=1','MAJORIS_CEF_TEST_BASIC_STORE=1'],timeout:35,is_parallel:false)
  threat_navigation=executable('cef-threat-test',domain_sources,'tests/cef/threats.vala','native/cef/vala/majoris-cef.vapi',dependencies:domain_deps+[cef_dep])
  test('cef-threat-navigation',python,args:[meson.project_source_root()/'tests/cef/threats-runner.py',threat_navigation.full_path(),meson.project_build_root()/'native/cef/majoris-browser-cef-subprocess',cef_root/'Release'],env:['MAJORIS_CEF_TEST_HEADLESS=1','MAJORIS_CEF_TEST_BASIC_STORE=1'],timeout:30,is_parallel:false)
  accessibility_test=executable('cef-accessibility-test','tests/cef/accessibility.vala','native/cef/vala/majoris-cef.vapi',dependencies:[gio,cef_dep])
  test('cef-accessibility',python,args:[meson.project_source_root()/'tests/cef/accessibility-runner.py',accessibility_test.full_path(),meson.project_build_root()/'native/cef/majoris-browser-cef-subprocess',cef_root/'Release',meson.project_source_root()/'tests/fixtures'],env:['MAJORIS_CEF_TEST_HEADLESS=1','MAJORIS_CEF_TEST_BASIC_STORE=1'],timeout:35,is_parallel:false)
  exit_test=executable('cef-exit-test','src/sessions/exit-operation.vala','tests/cef/exit.vala','native/cef/vala/majoris-cef.vapi',dependencies:[gio,cef_dep])
  test('cef-exit',python,args:[meson.project_source_root()/'tests/cef/exit-runner.py',exit_test.full_path(),isolation_test.full_path(),meson.project_build_root()/'native/cef/majoris-browser-cef-subprocess',cef_root/'Release',meson.project_source_root()/'tests/fixtures'],env:['MAJORIS_CEF_TEST_HEADLESS=1','MAJORIS_CEF_TEST_BASIC_STORE=1'],timeout:70,is_parallel:false)
  uninstall_test=executable('uninstall-test',domain_sources,'src/webapps/web-app-manager.vala','src/integration/shell-integration.vala','tests/integration/uninstall.vala','native/cef/vala/majoris-cef.vapi',dependencies:domain_deps+[cef_dep,dependency('gdk-pixbuf-2.0')])
  test('app-uninstall',uninstall_test,is_parallel:false)
  storage_test=executable('cef-storage-test','tests/cef/storage.vala','native/cef/vala/majoris-cef.vapi',dependencies:[gio,json,cef_dep])
  site_cookie_test=executable('cef-site-cookie-test','tests/cef/site-cookies.vala','native/cef/vala/majoris-cef.vapi',dependencies:[gio,cef_dep])
  download_test=executable('cef-download-test',domain_sources,'src/services/store-worker.vala','src/downloads/download-service.vala','src/downloads/download-record.vala','tests/cef/downloads.vala','native/cef/vala/majoris-cef.vapi',dependencies:domain_deps+[cef_dep],c_args:['-DGETTEXT_PACKAGE="majoris-browser"'])
  notification_probe=executable('cef-notification-probe','tests/cef/notifications.vala','native/cef/vala/majoris-cef.vapi',dependencies:[gio,json,cef_dep])
  permission_test=executable('cef-permission-test',domain_sources,'src/services/store-worker.vala','src/permissions/permission-service.vala','tests/cef/permissions.vala','native/cef/vala/majoris-cef.vapi',dependencies:domain_deps+[cef_dep])
  close_test=executable('cef-close-test','tests/cef/close.vala','native/cef/vala/majoris-cef.vapi',dependencies:[gio,cef_dep])
  context_test=executable('cef-context-test','tests/cef/context-menus.vala','native/cef/vala/majoris-cef.vapi',dependencies:[gio,json,cef_dep])
  print_test=executable('cef-print-test','tests/cef/printing.vala','native/cef/vala/majoris-cef.vapi',dependencies:[gio,cef_dep])
  print_xvfb=find_program('xvfb-run',required:false)
  if print_xvfb.found()
    test('cef-printing',print_xvfb,args:['-a',python.full_path(),meson.project_source_root()/'tests/cef/permissions-runner.py',print_test.full_path(),meson.project_build_root()/'native/cef/majoris-browser-cef-subprocess',cef_root/'Release',meson.project_source_root()/'tests/fixtures'],env:['MAJORIS_CEF_TEST_BASIC_STORE=1'],timeout:40,is_parallel:false)
  endif
  test('cef-context-menus',python,args:[meson.project_source_root()/'tests/cef/permissions-runner.py',context_test.full_path(),meson.project_build_root()/'native/cef/majoris-browser-cef-subprocess',cef_root/'Release',meson.project_source_root()/'tests/fixtures','context.html'],env:['MAJORIS_CEF_TEST_HEADLESS=1','MAJORIS_CEF_TEST_BASIC_STORE=1'],timeout:40,is_parallel:false)
  test('cef-close',python,args:[meson.project_source_root()/'tests/cef/permissions-runner.py',close_test.full_path(),meson.project_build_root()/'native/cef/majoris-browser-cef-subprocess',cef_root/'Release',meson.project_source_root()/'tests/fixtures'],env:['MAJORIS_CEF_TEST_HEADLESS=1','MAJORIS_CEF_TEST_BASIC_STORE=1'],timeout:25,is_parallel:false)
  test('cef-permissions',python,args:[meson.project_source_root()/'tests/cef/permissions-runner.py',permission_test.full_path(),meson.project_build_root()/'native/cef/majoris-browser-cef-subprocess',cef_root/'Release',meson.project_source_root()/'tests/fixtures'],env:['MAJORIS_CEF_TEST_HEADLESS=1','MAJORIS_CEF_TEST_BASIC_STORE=1'],timeout:35,is_parallel:false)
  test('cef-downloads',python,args:[meson.project_source_root()/'tests/cef/downloads-runner.py',download_test.full_path(),meson.project_build_root()/'native/cef/majoris-browser-cef-subprocess',cef_root/'Release'],env:['MAJORIS_CEF_TEST_HEADLESS=1','MAJORIS_CEF_TEST_BASIC_STORE=1'],timeout:40,is_parallel:false)
  test('cef-site-cookies',python,args:[meson.project_source_root()/'tests/cef/site-cookies-runner.py',site_cookie_test.full_path(),meson.project_build_root()/'native/cef/majoris-browser-cef-subprocess',cef_root/'Release'],env:['MAJORIS_CEF_TEST_HEADLESS=1','MAJORIS_CEF_TEST_BASIC_STORE=1'],timeout:40,is_parallel:false)
  test('cef-storage-isolation',python,args:[meson.project_source_root()/'tests/cef/storage-runner.py',storage_test.full_path(),isolation_test.full_path(),meson.project_build_root()/'native/cef/majoris-browser-cef-subprocess',cef_root/'Release',meson.project_source_root()/'tests/fixtures'],env:['MAJORIS_CEF_TEST_HEADLESS=1','MAJORIS_CEF_TEST_BASIC_STORE=1'],timeout:100,is_parallel:false)
  dbus_session = find_program('dbus-run-session', required: false)
  certutil=find_program('certutil',required:false)
  keyring=find_program('gnome-keyring-daemon',required:false)
  if dbus_session.found() and certutil.found() and keyring.found()
    platform_xvfb=find_program('xvfb-run',required:false)
    if platform_xvfb.found()
      platform_test=executable('cef-platform-test','src/core/url-resolver.vala','tests/cef/platform.vala','native/cef/vala/majoris-cef.vapi',dependencies:[gio,json,cef_dep])
      test('cef-platform',dbus_session,args:['--',platform_xvfb.full_path(),'-a',python.full_path(),meson.project_source_root()/'tests/cef/credentials-runner.py',platform_test.full_path(),meson.project_build_root()/'native/cef/majoris-browser-cef-subprocess',cef_root/'Release',meson.project_source_root()/'tests/fixtures','media.html'],env:['GDK_BACKEND=x11'],timeout:60,is_parallel:false)
    endif
    auth_test=executable('cef-authentication-test','src/core/url-resolver.vala','tests/cef/authentication.vala','native/cef/vala/majoris-cef.vapi',dependencies:[gio,json,cef_dep])
    test('cef-authentication',dbus_session,args:['--',python.full_path(),meson.project_source_root()/'tests/cef/credentials-runner.py',auth_test.full_path(),meson.project_build_root()/'native/cef/majoris-browser-cef-subprocess',cef_root/'Release',meson.project_source_root()/'tests/fixtures','auth-app/index.html'],env:['MAJORIS_CEF_TEST_HEADLESS=1'],timeout:60,is_parallel:false)
    modern_credential_test=executable('cef-modern-credential-test',domain_sources,'src/credentials/credential-store.vala','tests/cef/modern-credentials.vala','native/cef/vala/majoris-cef.vapi',dependencies:domain_deps+[cef_dep,dependency('libsecret-1')])
    test('cef-modern-credentials',dbus_session,args:['--',python.full_path(),meson.project_source_root()/'tests/cef/credentials-runner.py',modern_credential_test.full_path(),meson.project_build_root()/'native/cef/majoris-browser-cef-subprocess',cef_root/'Release',meson.project_source_root()/'tests/fixtures','modern-login.html?mode=async'],env:['MAJORIS_CEF_TEST_HEADLESS=1'],timeout:90,is_parallel:false)
    credential_test=executable('cef-credential-test',domain_sources,'src/credentials/credential-store.vala','tests/cef/credentials.vala','native/cef/vala/majoris-cef.vapi',dependencies:domain_deps+[cef_dep,dependency('libsecret-1')])
    test('cef-credentials',dbus_session,args:['--',python.full_path(),meson.project_source_root()/'tests/cef/credentials-runner.py',credential_test.full_path(),meson.project_build_root()/'native/cef/majoris-browser-cef-subprocess',cef_root/'Release',meson.project_source_root()/'tests/fixtures'],env:['MAJORIS_CEF_TEST_HEADLESS=1'],timeout:50,is_parallel:false)
  endif
  isolation_args = [meson.project_build_root() / 'native/cef/majoris-browser-cef-subprocess', cef_root / 'Release']
  if dbus_session.found()
    test('cef-cookie-isolation', dbus_session, args: ['--', python.full_path(), meson.project_source_root() / 'tests/cef/isolation-runner.py', isolation_test.full_path()] + isolation_args, env: ['MAJORIS_CEF_TEST_HEADLESS=1','MAJORIS_CEF_TEST_BASIC_STORE=1'], timeout: 100,is_parallel:false)
  else
    test('cef-cookie-isolation', python, args: [meson.project_source_root() / 'tests/cef/isolation-runner.py', isolation_test.full_path()] + isolation_args, env: ['MAJORIS_CEF_TEST_HEADLESS=1'], timeout: 100,is_parallel:false)
  endif
  subdir('data')
  subdir('src')
  subdir('po')
endif

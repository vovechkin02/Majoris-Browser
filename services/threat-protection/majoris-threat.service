[Unit]
Description=Authorised Majoris threat-provider backend
After=network-online.target
Wants=network-online.target

[Service]
User=majoris-threat
Group=majoris-threat
ExecStart=/usr/bin/python3 /opt/majoris-threat/server.py --config /etc/majoris-threat/config.json
Restart=on-failure
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=256M
TasksMax=64
UMask=0077

[Install]
WantedBy=multi-user.target

# Operator supplies the DNS name and certificate paths. Do not enable HTTP.
limit_conn_zone $binary_remote_addr zone=majoris_clients:10m;
limit_req_zone $binary_remote_addr zone=majoris_requests:10m rate=10r/s;
server {
    listen 443 ssl;
    server_name threat.example.invalid;
    ssl_certificate /etc/majoris-threat/tls/fullchain.pem;
    ssl_certificate_key /etc/majoris-threat/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    access_log off;
    error_log /dev/null;
    client_header_timeout 5s;
    client_body_timeout 5s;
    client_max_body_size 1k;
    large_client_header_buffers 4 32k;
    limit_conn majoris_clients 8;
    limit_req zone=majoris_requests burst=20 nodelay;
    limit_req_status 429;
    location ~ ^/(v1/uris:search|health)$ {
        limit_except GET { deny all; }
        proxy_pass http://127.0.0.1:8787;
        proxy_connect_timeout 2s;
        proxy_read_timeout 4s;
        proxy_send_timeout 4s;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header Host $host;
        proxy_buffering off;
    }
    location / { return 404; }
}

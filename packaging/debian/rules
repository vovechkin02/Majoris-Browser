#!/usr/bin/make -f
%:
	dh $@ --buildsystem=meson
override_dh_auto_configure:
	test -n "$(CEF_ROOT)"
	dh_auto_configure -- -Dcef_root=$(CEF_ROOT)
override_dh_fixperms:
	dh_fixperms
	chmod 4755 debian/majoris-browser/usr/lib/*/majoris-browser/cef/chrome-sandbox
override_dh_strip:
	dh_strip --exclude=/majoris-browser/cef/
override_dh_dwz:
	dh_dwz --exclude=/majoris-browser/cef/
